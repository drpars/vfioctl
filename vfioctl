#!/usr/bin/env python3
"""vfioctl -- install, check and drive a VFIO GPU passthrough setup.

    ./vfioctl doctor              # what is this machine, and may we write here
    ./vfioctl profiles            # which machines this tool claims
    ./vfioctl install             # write the host-side setup
    ./vfioctl install --check     # compare /etc with what install would write
    ./vfioctl uninstall           # take it back out
    ./vfioctl selftest            # five handover rounds, judged and logged
    ./vfioctl guest setup         # the guest side -- `guest --help` for its own

EVERY WRITING SUBCOMMAND GOES THROUGH doctor.gate() AND NONE OF THEM DERIVES
ITS OWN CHECK. There is one answer to "may we write on this machine" so that
adding a subcommand cannot accidentally skip it, and there is deliberately no
flag that turns a closed gate into an open one.

NOTHING HERE TOUCHES THE CARD. install writes files; selftest starts a guest
and reads. The card is moved by the libvirt hook, as root, under libvirtd,
behind its own lsmod gate -- one writer, on purpose. Writing to unbind or
drivers_probe from anywhere else is what wedged this machine three times.

THE GUEST SIDE IS A NAMESPACE, NOT A FLATTENED LIST (K15, decided once the
guest side was finished -- deciding earlier would have meant designing this
subcommand twice). `vfioctl guest <cmd>` rather than seven more names beside
install and selftest, because the two halves differ in what they need before
they can run: everything above writes to /etc through sudo and touches no
guest, everything under `guest` talks to libvirt and a running Windows and
wants no root at all. Folding them into one list would hide that distinction
in a help page and put two different `status` in one namespace.

guest/build.py IS NO LONGER RUNNABLE ON ITS OWN, and that is the point: one
job, one runnable name. The second name is what goes stale, because nothing
tests it.
"""

from __future__ import annotations

import argparse
import importlib.util
import sys
from pathlib import Path

from core import doctor, install as install_mod, profile as profile_mod, selftest

HERE = Path(__file__).resolve().parent


def cmd_doctor(args) -> int:
    return doctor.report(args.profile)


def cmd_profiles(args) -> int:
    profiles = profile_mod.all_profiles()
    if not profiles:
        print("Hiç profil yok.")
        return 1
    for p in profiles:
        print(f"{p.name}\n  {p.title}")
        for product in p.dmi_products:
            print(f"  DMI: {product}")
    return 0


def cmd_install(args) -> int:
    if args.check:
        return install_mod.check(args.profile, args.kvmfr_mb)
    return install_mod.install(args.profile, args.kvmfr_mb)


def cmd_uninstall(args) -> int:
    return install_mod.uninstall(args.profile, args.kvmfr_mb)


def cmd_selftest(args) -> int:
    return selftest.run(
        rounds=args.rounds,
        domain=args.domain,
        compositor=args.compositor,
        poller=None if args.no_poller else args.poller,
        profile_name=args.profile,
        assume_yes=args.yes,
        preflight_only=args.preflight,
        boot_timeout=args.boot_timeout,
        shutdown_timeout=args.shutdown_timeout,
    )


def split_guest(argv: list[str]) -> tuple[list[str], list[str]] | None:
    """(what came before `guest`, what came after), or None if this is not it.

    THE HANDOFF HAPPENS BEFORE argparse, NOT THROUGH IT. argparse's REMAINDER
    only starts capturing at the first token that does not look like an option,
    so `vfioctl guest --help` and `vfioctl guest --name win11-test setup` were
    read as THIS parser's flags and rejected (measured, both of them -- and the
    second is the form the guest scripts' own headers tell a reader to type).
    Splitting here is what makes the namespace transparent: everything after
    `guest` belongs to the parser that owns it, options included.
    """
    i = 0
    while i < len(argv):
        token = argv[i]
        if token == "guest":
            return argv[:i], argv[i + 1:]
        # --profile is this parser's only value-taking option; skipping its
        # argument keeps a domain that happens to be called "guest" from
        # looking like the subcommand.
        i += 2 if token == "--profile" else 1
        if token.startswith("-"):
            continue
        return None
    return None


def cmd_guest(head: list[str], rest: list[str]) -> int:
    """Hand the rest of the command line to the guest side, unread.

    guest/ is not a package -- it is a directory next to this file -- so the
    module is loaded by path, the same way build.py reaches core/. Nothing here
    interprets the arguments: they are parsed once, by the parser that owns
    them, so a flag added there needs no edit here.
    """
    if head:
        print(f"vfioctl: {' '.join(head)} misafir tarafından önce verilemez -- "
              "bu seçenekler alt komuttan sonra gelir, örn. "
              "`vfioctl guest passthrough --profile <ad>`", file=sys.stderr)
        return 2
    path = HERE / "guest" / "build.py"
    spec = importlib.util.spec_from_file_location("vfioctl_guest_build", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module.main(rest)


def main() -> int:
    split = split_guest(sys.argv[1:])
    if split is not None:
        return cmd_guest(*split)

    parser = argparse.ArgumentParser(
        prog="vfioctl",
        description="VFIO GPU passthrough kurulumunu kur, ölç ve sür",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument("--profile", default=None,
                        help="DMI ile seçmek yerine adı verilen profili kullan")
    sub = parser.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("doctor", help="makineyi ölç, hiçbir şey yazma")
    d.set_defaults(func=cmd_doctor)

    pl = sub.add_parser("profiles", help="tanınan makineleri listele")
    pl.set_defaults(func=cmd_profiles)

    ins = sub.add_parser("install", help="host tarafını kur")
    ins.add_argument("--check", action="store_true",
                     help="hiçbir şey yazma, kurulu hâlle farkı göster")
    ins.add_argument("--kvmfr-mb", type=int, default=None,
                     help="kvmfr paylaşımlı bellek boyutu (varsayılan: en büyük "
                          "bağlı ekrandan hesaplanır)")
    ins.set_defaults(func=cmd_install)

    un = sub.add_parser("uninstall", help="kurulanı geri al")
    un.add_argument("--kvmfr-mb", type=int, default=None,
                    help=argparse.SUPPRESS)
    un.set_defaults(func=cmd_uninstall)

    st = sub.add_parser("selftest", help="devri art arda N tur koş ve yargıla")
    st.add_argument("--rounds", type=int, default=5,
                    help="tur sayısı (varsayılan 5 — kabul ölçütü)")
    st.add_argument("--domain", default="win11", help="libvirt domain adı")
    st.add_argument("--compositor", default="Hyprland",
                    help="hayatta kaldığı denetlenecek süreç")
    st.add_argument("--poller", default="waybar",
                    help="kartı yoklayan süreç — testin parçası")
    st.add_argument("--no-poller", action="store_true",
                    help="yoklayıcısız taban çizgisi; kabul turu değildir")
    st.add_argument("--boot-timeout", type=int, default=300,
                    help="misafirin ajanı cevaplaması için saniye (varsayılan 300)")
    st.add_argument("--shutdown-timeout", type=int, default=300,
                    help="misafirin kapanması için saniye (varsayılan 300)")
    st.add_argument("--preflight", action="store_true",
                    help="yalnızca okuma: devir şu an geçer miydi — VM başlatma")
    st.add_argument("--yes", action="store_true",
                    help="VT uyarısını sorma")
    st.set_defaults(func=cmd_selftest)

    # REGISTERED SO THAT `vfioctl --help` LISTS THE NAMESPACE, never dispatched:
    # split_guest() has already handed the line over by the time parse_args runs.
    sub.add_parser("guest", help="misafir tarafı (kur, sür, kartı ver) -- "
                                 "kendi yardımı: guest --help",
                   add_help=False)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
